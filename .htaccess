DirectoryIndex index.php
Options -Indexes
<FilesMatch "^(config|lib|guard|events|formlist|sigtools|leadlib|pushlib|push_keys)\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "\.md$">
  Require all denied
</FilesMatch>
<Files "leadmsgs.json">
  Require all denied
</Files>
